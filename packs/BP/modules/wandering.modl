{
  // Idle wander behaviours.
  //
  // DEPENDS ON a module that defines the `calm` component group - in practice
  // `proximity_aggro`. jsonte merges templates, so this only contributes the
  // behaviours into that group; it does not create it, and it emits no event.
  // Used alone it is exactly the dead-code case proximity_aggro exists to
  // prevent, so always $extend both together.
  //
  // Requires from the extending file's $scope:
  //   calm_speed - feeds the stroll speed multiplier indirectly via movement
  "$module": "wandering",
  "$template": {
    "minecraft:entity": {
      "component_groups": {
        "calm": {
          "minecraft:behavior.random_stroll": {
            "priority": 6,
            "speed_multiplier": 1.0,
            "xz_dist": 10,
            "y_dist": 7,
            "interval": 120
          },
          "minecraft:behavior.look_at_player": {
            "priority": 7,
            "look_distance": 8,
            "probability": 0.02
          },
          "minecraft:behavior.random_look_around": {
            "priority": 8
          }
        }
      }
    }
  }
}
