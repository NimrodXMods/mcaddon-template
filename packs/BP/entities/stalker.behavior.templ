{
  // A mob that wanders obliviously until you get close, then chases you down -
  // and runs away for a few seconds if you hurt it.
  //
  // Three states: calm <-> aggro on proximity, either -> fleeing on damage,
  // fleeing -> calm on a timer. The whole machine comes from the modules
  // below. Authoring a new mob of this shape means changing the identifier and
  // the numbers in $scope - not copying component groups and hoping their
  // events came with them.
  "$extend": ["wandering", "proximity_aggro", "flee_on_damage"],
  "$scope": {
    // Derived here, not in data.json: a global scope value is only
    // substituted once, so a nested {{...}} inside one survives into the
    // output verbatim. A $scope entry gets the extra evaluation pass.
    // See docs/bedrock-jsonte-notes.md.
    "namespace": "{{studio + '_' + pack}}",
    "asset_path": "{{studio + '/' + pack}}",
    "aggro_range": 4,
    "calm_range": 12,
    "calm_speed": 0.25,
    "chase_speed": 0.45,
    "flee_speed": 0.5,
    "flee_seconds": 5
  },
  "$template": {
    "format_version": "1.26.40",
    "minecraft:entity": {
      "description": {
        "identifier": "{{namespace}}:stalker",
        "is_spawnable": true,
        "is_summonable": true
      },
      "components": {
        "minecraft:health": { "value": 20, "max": 20 },
        // Matches geometry.skeleton.v1.8 on the RP side (vanilla skeleton is
        // 1.9 x 0.6). This is the physical hitbox only - it does NOT position
        // the model. Where the mob's feet land is set by the geometry's 0,0,0
        // origin. A mismatch means you swing at visible air, or hit nothing
        // where the model looks solid; it never makes the mob float or sink.
        "minecraft:collision_box": { "height": 1.9, "width": 0.6 },
        // NOT "inanimate" - example_entity claims that, but a mob that walks
        // and attacks is not inanimate and vanilla filters key off this.
        "minecraft:type_family": { "family": ["{{namespace}}", "stalker", "monster", "mob"] },
        "minecraft:physics": {},
        // Vanilla monsters all carry this, and a mob under
        // population_control: "monster" that never despawns occupies its cap
        // slot permanently. Side effect while testing: a summoned stalker can
        // now vanish when you walk away.
        "minecraft:despawn": { "despawn_from_distance": {} },
        // NOT minecraft:pushable - that was split at some point between
        // format_version 1.26.0 and 1.26.40, and using it at 1.26.40 makes the
        // WHOLE ENTITY fail to load. The new pair is presence-based: an empty
        // object enables it, there are no is_pushable / is_pushable_by_piston
        // fields. pushable_by_block is the piston case.
        "minecraft:pushable_by_entity": {},
        "minecraft:pushable_by_block": {},
        "minecraft:movement.basic": {},
        "minecraft:navigation.walk": {
          "can_path_over_water": false,
          "avoid_water": true
        },
        "minecraft:jump.static": {},
        "minecraft:attack": { "damage": 3 },
        "minecraft:behavior.float": { "priority": 0 },
        // Path is relative to the BP root and the schema pins it to
        // ^loot_tables/.*.json$ - the directory prefix is not optional.
        //
        // NOT loot_tables/entities/ like vanilla: Cooperative Add-On rules
        // reject `entities` as a common-term folder here exactly as they do
        // under textures/ (CADDONREQ102/104). Copying vanilla's own layout
        // fails the gate.
        "minecraft:loot": { "table": "loot_tables/{{asset_path}}/stalker.loot.json" }
      }
    }
  }
}
