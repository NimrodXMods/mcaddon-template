# Repository stores LF; Windows working copies get CRLF on checkout.
* text=auto eol=crlf

# Shell scripts must stay LF even on Windows. bash fails on a CR in the
# shebang line, and scripts/verify.sh runs on a Linux CI runner.
*.sh text eol=lf

# YAML is LF by convention and is consumed by Linux runners.
*.yml text eol=lf
*.yaml text eol=lf

# Binary - never touch these.
*.png binary
*.mcstructure binary
*.mcaddon binary
*.mcworld binary
*.mcpack binary
*.mctemplate binary
